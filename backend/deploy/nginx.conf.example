# /etc/nginx/sites-available/sireprinting-chatbot
# Reverse proxy + TLS for the Sire Printing chatbot server.
# Point chat.yourdomain.com's DNS A record at this server first, then:
#   sudo ln -s /etc/nginx/sites-available/sireprinting-chatbot /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d chat.yourdomain.com
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name chat.yourdomain.com;

    # (certbot rewrites this block to add listen 443 ssl + certificate paths)

    client_max_body_size 128k;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Do NOT add X-Frame-Options here - the /chat route must be iframe-embeddable.
        proxy_read_timeout 120s;
    }
}
