# /etc/nginx/sites-available/sireprinting-chatbot
# Reverse proxy + TLS for the Sire Printing chatbot server.
# Point bot.sireprinting.co.uk's DNS A record at this server first, then:
#   sudo ln -s /etc/nginx/sites-available/sireprinting-chatbot /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d bot.sireprinting.co.uk
#   sudo nginx -t && sudo systemctl reload nginx

# Lets live connections (WebSockets, for live visitors / chat takeover later)
# pass through; ordinary requests are unaffected.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name bot.sireprinting.co.uk;

    # (certbot rewrites this block to add listen 443 ssl + certificate paths)

    # The admin panel uploads chatbot photos (up to ~700 KB); chat bodies stay small (64 KB, enforced by the app).
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        # Do NOT add X-Frame-Options here - the /chat route must be iframe-embeddable.
        # Training a chatbot from a website can take up to a minute.
        proxy_read_timeout 120s;
    }
}
