# ---- Copy this file to .env and fill in real values ----

# Port the Node server listens on (nginx will proxy to this)
PORT=5000

# Google Gemini API key - FREE, no credit card required.
# https://aistudio.google.com/apikey  (sign in with a Google account -> Create API key)
GEMINI_API_KEY=your-key-here
# Free tier meters requests PER MODEL PER DAY, so the app falls through this
# chain (primary first, then fallbacks) to stretch the free quota. "lite" models
# have the biggest free daily limits.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest

# MongoDB.
# Local:  mongodb://127.0.0.1:27017/sireprinting
# Atlas:  Atlas -> Database -> Connect -> Drivers -> copy the mongodb+srv://... URI
#         (add /sireprinting before the '?' to name the database)
#         and add your server IP under Atlas -> Network Access.
MONGODB_URI=mongodb://127.0.0.1:27017/sireprinting

# Public HTTPS URL where this server is reachable. Used to build the widget
# iframe src and the embed snippet. No trailing slash.
PUBLIC_URL=https://chat.yourdomain.com

# Password for the /admin dashboard. Use something long and random.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Comma- or space-separated list of website origins allowed to embed the widget.
# Use * to allow any site (fine to start with).
ALLOWED_FRAME_ORIGINS=*

# --- Optional widget branding defaults (can also be set per-site on the <script> tag) ---
WIDGET_TITLE=Sire Printing
WIDGET_ACCENT=#4f46e5
AGENT_NAME=Zack

# Where visitors are told to email artwork / reference files.
SALES_EMAIL=zack@sireprinting.com
